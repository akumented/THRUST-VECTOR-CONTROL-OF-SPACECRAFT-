module direction_fsm(
    input wire clk,
    input wire rst,

    input wire target_dir,
    input wire [7:0] requested_pwm,
    input wire [7:0] current_pwm,

    output reg motor_dir,
    output reg [7:0] target_pwm
);

    localparam RUNNING   = 2'd0;
    localparam RAMP_DOWN = 2'd1;
    localparam CHANGE    = 2'd2;

    reg [1:0] state;

    always @(posedge clk or posedge rst)
    begin
        if(rst)
        begin
            state <= RUNNING;
            motor_dir <= 0;
            target_pwm <= 0;
        end
        else
        begin
            case(state)

            //----------------------------------
            RUNNING:
            //----------------------------------
            begin
                target_pwm <= requested_pwm;

                if(target_dir != motor_dir)
                    state <= RAMP_DOWN;
            end

            //----------------------------------
            RAMP_DOWN:
            //----------------------------------
            begin
                target_pwm <= 0;

                if(current_pwm == 0)
                    state <= CHANGE;
            end

            //----------------------------------
            CHANGE:
            //----------------------------------
            begin
                motor_dir <= target_dir;
                target_pwm <= requested_pwm;
                state <= RUNNING;
            end

            default:
                state <= RUNNING;

            endcase
        end
    end

endmodule
